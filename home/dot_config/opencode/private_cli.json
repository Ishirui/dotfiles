{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "catppuccin-macchiato"
  },
  "keybinds": {
    "command.palette.show": "ctrl+o",
    "open.menu": "ctrl+i"
  },
  "plugins": [
    "~/dd/opencode-datadog/"
  ],
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "show",
    "permissions": "autoaccept"
  },
  "animations": true
}
