{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": ["datadog", "anthropic", "openai", "google", "github-copilot", "opencode-go"],
  "share": "disabled",
  "permissions": [
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "cd *", "effect": "allow" },
    { "action": "shell", "resource": "ls *", "effect": "allow" },
    { "action": "shell", "resource": "cat *", "effect": "allow" },
    { "action": "shell", "resource": "grep *", "effect": "allow" },
    { "action": "shell", "resource": "tail *", "effect": "allow" },
    { "action": "shell", "resource": "head *", "effect": "allow" },
    { "action": "shell", "resource": "wc *", "effect": "allow" },
    { "action": "shell", "resource": "rg *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr view *", "effect": "allow" },
    { "action": "shell", "resource": "echo *", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/dd/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/go/src/github.com/DataDog/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/Projects/*", "effect": "allow" },
  ],
  "plugins": [
    "~/dd/opencode-datadog/",
    "@plannotator/opencode",
    "@datadog/opencode-plugin",
    "@gotgenes/opencode-agent-identity",
    {
      "package": "@knikolov/opencode-plugin-simple-memory",
      "options": {
        "autoLoad": false,
        "autoSave": false,
      },
    },
    "opencode-handoff",
    "superpowers@git+https://github.com/obra/superpowers.git",
    // Take some stuff from https://github.com/smartfrog/opencode-froggy/ but without using it wholesale
  ],
}
