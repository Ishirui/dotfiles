{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": ["anthropic", "openai", "google", "github-copilot"],
  "share": "disabled",
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "cd *": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "grep *": "allow",
      "tail *": "allow",
      "head *": "allow",
      "wc *": "allow",
      "rg *": "allow",
      "git log *": "allow",
      "git diff *": "allow",
      "git status *": "allow",
      "gh pr view *": "allow",
      "echo *": "allow",
    },
    "webfetch": "allow",
    "doom_loop": "ask",
    "external_directory": "allow",
  },
  "plugin": [
    "~/dd/opencode-datadog/",
    "@plannotator/opencode",
    "@gotgenes/opencode-agent-identity",
    [
      "@knikolov/opencode-plugin-simple-memory",
      {
        "autoLoad": false,
        "autoSave": false,
      },
    ],
    "opencode-handoff",
    "superpowers@git+https://github.com/obra/superpowers.git",
    // Take some stuff from https://github.com/smartfrog/opencode-froggy/ but without using it wholesale
  ],
}
